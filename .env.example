# Public build-time URL of the Cloudflare Worker API (no path, no trailing slash).
# Example for local development: http://localhost:8787
# Leave empty to run the frontend in offline guide mode.
# WARNING: VITE_* variables are public in the built site. Never put an API key,
# a Cloudflare credential, or any other secret in a VITE_* variable.
VITE_API_BASE_URL=
